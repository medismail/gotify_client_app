#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/windows_resource.h"

IDI_GOTIFY ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/gotify.ico"

IDD_SETTINGS DIALOGEX 0, 0, 290, 128
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gotify Client Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Server URL:", -1, 12, 12, 266, 12
    EDITTEXT IDC_SETTINGS_URL, 12, 27, 266, 14, ES_AUTOHSCROLL
    LTEXT "Client token:", -1, 12, 49, 266, 12
    EDITTEXT IDC_SETTINGS_TOKEN, 12, 64, 266, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON "Save && Reconnect", IDOK, 103, 97, 105, 18
    PUSHBUTTON "Cancel", IDCANCEL, 217, 97, 61, 18
END
